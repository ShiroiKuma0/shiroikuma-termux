<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux (Phase 4): the 白い熊 Termux UI page.
     PreferenceCategory = section (kxkb header layouts; the FIRST section takes the `_first` layout
     without the hairline), a non-selectable ShiroikumaPreference with the subheader layout = a
     sub-heading, rows at indent1 (72 dp, directly under a section) or indent2 (90 dp, under a
     sub-heading). Nothing here persists on its own (persistent="false" everywhere):
     ShiroikumaUiFragment wires every row by key to ShiroikumaTheme (prefs file `shiroikuma_ui`)
     or to the terminal files under ~/.termux, and every change previews live. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Export / Import — the first section of every sister app's page (Phase 4b). The panel, the
         backup directory (absolute path; red while unset, a red second line while All-files
         access is missing), the last export (queried on resume), and — directly below, never as a
         section of their own — the three 保存復元 automation rows of the contract §2: the master
         switch (default ON), 「Use authorization token?」 (default OFF), and the token row shown
         only while it is asked for. The automation flags live in the device-local
         `shiroikuma_automation` file, the directory in `shiroikuma_eximport`; neither is ever
         exported (persistent="false" here, wired by ShiroikumaUiFragment.wireExportImport()). -->
    <PreferenceCategory
        android:title="@string/shiroikuma_ui_section_eximport"
        android:layout="@layout/preference_category_shiroikuma_first">

        <com.termux.shiroikuma.ui.ShiroikumaPreference
            android:key="eximport"
            android:title="@string/shiroikuma_eim_entry"
            android:summary="@string/shiroikuma_eim_entry_desc"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
        <com.termux.shiroikuma.ui.ShiroikumaPreference
            android:key="export_dir"
            android:title="@string/shiroikuma_eim_dir"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
        <com.termux.shiroikuma.ui.ShiroikumaPreference
            android:key="last_export"
            android:title="@string/shiroikuma_eim_last_title"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:selectable="false"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="automation_enabled"
            android:title="@string/shiroikuma_auto_switch"
            android:summary="@string/shiroikuma_auto_switch_desc"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="automation_require_token"
            android:title="@string/shiroikuma_auto_require_token"
            android:summary="@string/shiroikuma_auto_require_token_desc"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
        <com.termux.shiroikuma.ui.AutomationTokenPreference
            android:key="automation_token"
            android:title="@string/shiroikuma_auto_token"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:widgetLayout="@layout/preference_widget_regenerate"
            android:persistent="false" />
    </PreferenceCategory>

