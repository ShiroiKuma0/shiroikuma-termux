<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux (Phase 4, kxkb spec): item row directly under a section (72 dp) —
     minHeight 0, 5 dp vertical padding, 16 sp yellow title, 13 sp dim summary, the widget frame
     (colour swatch / switch) on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="0dp"
    android:paddingStart="72dp"
    android:paddingLeft="72dp"
    android:paddingEnd="16dp"
    android:paddingRight="16dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/shiroikuma_yellow"
            android:textSize="16sp" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/shiroikuma_yellow_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:gravity="center"
        android:orientation="vertical" />
</LinearLayout>
