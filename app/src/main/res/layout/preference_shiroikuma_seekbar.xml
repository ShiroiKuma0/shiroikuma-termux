<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux (Phase 4, kxkb spec): seekbar row at 72 dp — title, dim summary, then the
     slider with its live value (44 dp, right-aligned). Bound by ShiroikumaSeekBarPreference via
     @id/seekbar and @id/seekbar_value (the androidx.preference ids, merged by name). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="0dp"
    android:paddingStart="72dp"
    android:paddingLeft="72dp"
    android:paddingEnd="16dp"
    android:paddingRight="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/shiroikuma_yellow"
        android:textSize="16sp" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/shiroikuma_yellow_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <SeekBar
            android:id="@+id/seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null" />

        <TextView
            android:id="@+id/seekbar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:gravity="end"
            android:textColor="@color/shiroikuma_yellow"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
