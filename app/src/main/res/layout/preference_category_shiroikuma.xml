<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux: the heading of a folding section of the UI page (ShiroikumaSectionCategory)
     — the 1 px line above it (kept folded or open), the section's icon and its 20 sp title, and a
     › / ⌄ at the right. Coloured, underlined and given its icon in code; no colour here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/sk_divider"
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingLeft="16dp"
        android:paddingEnd="16dp"
        android:paddingRight="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/sk_chevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
