<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux (Phase 4, kxkb spec): section header — a full-width 1 px yellow hairline
     separates it from the previous section, then the 20 sp bold yellow title at 36 dp with a
     text-wide 2.5 dp underline. The first section uses preference_category_shiroikuma_first.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/shiroikuma_yellow" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingLeft="36dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/shiroikuma_yellow"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="@color/shiroikuma_yellow" />
    </LinearLayout>
</LinearLayout>
