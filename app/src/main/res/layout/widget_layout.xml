<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux (Phase 4c): Termux:Widget's widget_layout.xml (see TermuxWidgetProvider for
     the upstream commit). Changes: house black/yellow defaults instead of the light list, the
     title TextView carries @id/widget_title so TermuxWidgetProvider can recolour it, and the list
     divider is the dim yellow. Colours / text size are re-applied from the 白い熊 Termux UI page's
     Widget section on every refresh. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp" >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp"
        android:paddingTop="6dp" >

        <LinearLayout
            android:id="@+id/top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF000000"
            android:orientation="horizontal"
            android:padding="6dp" >

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="2.0"
                android:text="@string/title_widget"
                android:textColor="#FFFFFF00"
                android:textSize="18sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_row"
            android:background="#FF000000"
            android:divider="#FFC8C800"
            android:dividerHeight="1px" >
        </ListView>

        <!-- Shown for empty collection due to rv.setEmptyView(R.id.widget_list, R.id.empty_view) being called: -->

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_row"
            android:background="#FF000000"
            android:padding="6dp"
            android:text="@string/msg_refresh_widget_from_app"
            android:textColor="#FFFFFF00" />
    </RelativeLayout>

    <ImageButton
        android:id="@+id/refresh_button"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/action_refresh"
        android:src="@android:drawable/stat_notify_sync" />

</RelativeLayout>
