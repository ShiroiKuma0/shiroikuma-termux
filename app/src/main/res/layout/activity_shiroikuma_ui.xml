<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux (Phase 4): host of the 白い熊 Termux UI page — a toolbar (the same @id/toolbar
     the other activities carry, so ShiroikumaChrome.applyToolbar styles it the same way) over the
     preference fragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shiroikuma_black"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/shiroikuma_black"
        android:minHeight="?attr/actionBarSize" />

    <FrameLayout
        android:id="@+id/shiroikuma_ui_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
