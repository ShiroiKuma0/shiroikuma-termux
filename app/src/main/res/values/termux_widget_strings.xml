<?xml version="1.0" encoding="utf-8"?>

<!-- shiroikuma-termux (Phase 4c): Termux:Widget's strings.xml (see TermuxWidgetProvider for the
     upstream commit) with our names in the entities. Dropped: app_name (no launcher entry) and the
     five texts of the unported TermuxWidgetMainActivity (plugin_info, the launcher-icon /
     max-shortcuts / dynamic-shortcuts / refresh-all info paragraphs). Added: widget_description. -->
<!DOCTYPE resources [
    <!ENTITY TERMUX_PACKAGE_NAME "com.termux">
    <!ENTITY TERMUX_APP_NAME "白い熊 Termux">
    <!ENTITY TERMUX_WIDGET_APP_NAME "白い熊 Termux Widget">
    <!ENTITY TERMUX_SHORTCUT_SCRIPTS_DIR_PATH_SHORT "~/.shortcuts/">
    <!ENTITY TERMUX_SHORTCUT_SCRIPT_ICONS_DIR_PATH_SHORT "~/.shortcuts/icons">
    ]>

<resources>
    <string name="plugin_api_help">Visit %1$s for more info on plugin usage.</string>
    <string name="widget_description">Runs the scripts in &TERMUX_SHORTCUT_SCRIPTS_DIR_PATH_SHORT; (tasks/ in the background)</string>

    <!-- dynamic shortcuts (driven from the 白い熊 Termux UI page → Widget) -->
    <string name="msg_created_dynamic_shortcuts_successfully">Created %1$d dynamic shortcuts successfully</string>
    <string name="msg_removed_dynamic_shortcuts_successfully">Removed dynamic shortcuts successfully</string>
    <string name="msg_no_shortcut_files_found_in_directory">No shortcut files found in `%1$s`</string>
    <string name="msg_no_dynamic_shortcuts_currently_created">No dynamic shortcuts currently created</string>
    <string name="msg_dynamic_shortcuts_limit_reached">Only %1$d shortcuts allowed (Android’s max_shortcuts limit)</string>
    <string name="msg_skipping_shortcut">Skipping shortcut `%1$s`</string>

    <string name="msg_refresh_widget_from_app">Open &TERMUX_APP_NAME; UI → Widget → Refresh widgets</string>

    <!-- ShortcutFile -->
    <string name="msg_shortcut_icon_file_used">Using file at `%1$s` as shortcut icon file</string>



    <!-- ShortcutUtils -->
    <string name="error_failed_to_get_shortcut_manager">Failed to get ShortcutManager</string>



    <string name="title_widget">&TERMUX_APP_NAME;</string>
    <string name="title_shortcut_widget_name">&TERMUX_WIDGET_APP_NAME;</string>
    <string name="title_single_shortcut_name">&TERMUX_APP_NAME; shortcut</string>
    <string name="title_termux_shortcuts">&TERMUX_APP_NAME; Shortcuts</string>

    <string name="msg_no_shortcut_scripts">No files in\n&TERMUX_SHORTCUT_SCRIPTS_DIR_PATH_SHORT;</string>
    <string name="msg_bad_token">This shortcut is invalid - remove and add again.</string>
    <string name="msg_executing_task">Executing task: \"%1$s\"</string>
    <string name="msg_executable_absolute_path">Executable Absolute Path: \"%1$s\"</string>
    <string name="msg_icon_absolute_path">Icon Absolute Path: \"%1$s\"</string>
    <string name="msg_request_create_pinned_shortcut">Requesting to create pinned shortcut for \"%1$s\"</string>
    <string name="msg_request_create_static_shortcut">Requesting to create static shortcut for \"%1$s\"</string>
    <string name="msg_widgets_refreshed">&TERMUX_APP_NAME; widgets refreshed: %1$s</string>
    <string name="msg_no_widgets_found_to_refresh">No &TERMUX_APP_NAME; widgets found to refresh</string>

    <string name="action_refresh">Refresh</string>

    <string name="error_null_or_empty_executable">The executable is null or empty.</string>
    <string name="error_executable_not_under_shortcuts_directories">An executable can only be
        executed if its under the following directories: %1$s</string>
    <string name="error_icon_not_under_shortcut_icons_directories">The icon is not under the following directories: %1$s</string>
    <string name="error_icon_not_a_regular_file">The icon file is not a regular file but is instead
        a \"%1$s\".</string>
    <string name="error_create_pinned_shortcut_failed">Failed to create pinned shortcut for \"%1$s\"</string>
    <string name="error_create_static_shortcut_failed">Failed to create static shortcut for \"%1$s\"</string>

</resources>
